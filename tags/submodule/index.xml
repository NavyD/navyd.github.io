&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="m"&gt;9&lt;/span&gt; 2021-08-06 00:58:32 /home/navyd/Workspaces/projects/navyd.github.io/static
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="m"&gt;10&lt;/span&gt; 2021-08-06 00:58:32 /home/navyd/Workspaces/projects/navyd.github.io/resources
