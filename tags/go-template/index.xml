<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Go Template on NavyD 的个人博客</title><link>/tags/go-template/</link><description>Recent content in Go Template on NavyD 的个人博客</description><generator>Hugo -- gohugo.io</generator><language>zh-cn</language><lastBuildDate>Fri, 14 Feb 2025 15:48:25 +0800</lastBuildDate><atom:link href="/tags/go-template/index.xml" rel="self" type="application/rss+xml"/><item><title>hugo 博客实践</title><link>/posts/2025/02/hugo-post-content-practice/</link><pubDate>Tue, 04 Feb 2025 15:40:12 +0800</pubDate><guid>/posts/2025/02/hugo-post-content-practice/</guid><description>&lt;p&gt;&lt;img src="/posts/2025/02/hugo-post-content-practice/20250204223346.png"
width="1026"
height="425"
srcset="/posts/2025/02/hugo-post-content-practice/20250204223346_hu_576638cd89b3cf0c.png 480w, /posts/2025/02/hugo-post-content-practice/20250204223346_hu_6410119bf9932132.png 1024w"
loading="lazy"
alt="hugo logo"
class="gallery-image"
