&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;a30ea67 &lt;span class="o"&gt;(&lt;/span&gt;origin/main, origin/HEAD&lt;span class="o"&gt;)&lt;/span&gt; HEAD@&lt;span class="o"&gt;{&lt;/span&gt;17&lt;span class="o"&gt;}&lt;/span&gt;: reset: moving to HEAD~
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;e440e06 HEAD@&lt;span class="o"&gt;{&lt;/span&gt;18&lt;span class="o"&gt;}&lt;/span&gt;: merge blog-res/master: Merge made by the &lt;span class="s1"&gt;&amp;#39;recursive&amp;#39;&lt;/span&gt; strategy.
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;a30ea67 &lt;span class="o"&gt;(&lt;/span&gt;origin/main, origin/HEAD&lt;span class="o"&gt;)&lt;/span&gt; HEAD@&lt;span class="o"&gt;{&lt;/span&gt;19&lt;span class="o"&gt;}&lt;/span&gt;: checkout: moving from main to blog
