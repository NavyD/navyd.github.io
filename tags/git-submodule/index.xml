&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class="lntd"&gt;
&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-sh" data-lang="sh"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;$ git log
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;commit 0504c8037617b01b6c90183a7b8fcdaf71216411 &lt;span class="o"&gt;(&lt;/span&gt;HEAD -&amp;gt; main, blog&lt;span class="o"&gt;)&lt;/span&gt;
