&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; Add &lt;span class="s1"&gt;&amp;#39;content/res/&amp;#39;&lt;/span&gt; from commit &lt;span class="s1"&gt;&amp;#39;34cef1f6fe6477181818e55ff468e9a62c7fccbf&amp;#39;&lt;/span&gt;
