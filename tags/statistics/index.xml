&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;Total Physical Source Lines of Code &lt;span class="o"&gt;(&lt;/span&gt;SLOC&lt;span class="o"&gt;)&lt;/span&gt; &lt;span class="o"&gt;=&lt;/span&gt; 10,282
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;Development Effort Estimate, Person-Years &lt;span class="o"&gt;(&lt;/span&gt;Person-Months&lt;span class="o"&gt;)&lt;/span&gt; &lt;span class="o"&gt;=&lt;/span&gt; 2.31 &lt;span class="o"&gt;(&lt;/span&gt;27.73&lt;span class="o"&gt;)&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="o"&gt;(&lt;/span&gt;Basic COCOMO model, Person-Months &lt;span class="o"&gt;=&lt;/span&gt; 2.4 * &lt;span class="o"&gt;(&lt;/span&gt;KSLOC**1.05&lt;span class="o"&gt;))&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;Schedule Estimate, Years &lt;span class="o"&gt;(&lt;/span&gt;Months&lt;span class="o"&gt;)&lt;/span&gt; &lt;span class="o"&gt;=&lt;/span&gt; 0.74 &lt;span class="o"&gt;(&lt;/span&gt;8.84&lt;span class="o"&gt;)&lt;/span&gt;
