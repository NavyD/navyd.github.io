&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="o"&gt;(&lt;/span&gt;average &lt;span class="nv"&gt;salary&lt;/span&gt; &lt;span class="o"&gt;=&lt;/span&gt; &lt;span class="nv"&gt;$56&lt;/span&gt;,286/year, &lt;span class="nv"&gt;overhead&lt;/span&gt; &lt;span class="o"&gt;=&lt;/span&gt; 2.40&lt;span class="o"&gt;)&lt;/span&gt;.
