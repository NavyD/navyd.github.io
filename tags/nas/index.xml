&lt;h4 id="优化参数配置"&gt;&lt;a href="#%e4%bc%98%e5%8c%96%e5%8f%82%e6%95%b0%e9%85%8d%e7%bd%ae" class="header-anchor"&gt;&lt;/a&gt;优化参数配置
&lt;/h4&gt;&lt;p&gt;参考
&lt;a
class="link"
href="https://immich.app/docs/features/facial-recognition#configuration"
target="_blank"
rel="noopener"
